# Copie este arquivo para ".env" (na VPS) e preencha. O ".env" NÃO vai para o repositório.

# Subdomínio do jogo, só o nome (sem https:// e sem caminho). Ex.: jogo.seu-dominio.com
SITE_DOMAIN=

# Painel de administração (/admin). Sem os dois, o painel fica desligado. Senha com 8 caracteres ou mais.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Porta interna do jogo na VPS (troque se já estiver em uso por outro projeto).
# WEB_PORT=8090

# Normalmente deixe de fora: o padrão libera a própria página (https://SITE_DOMAIN).
# Preencha só se a página abrir em outro endereço (separe por vírgula, sem caminho).
# ALLOWED_ORIGINS=

# Só para testar sem proxy (HTTP aberto, sem criptografia): WEB_BIND=0.0.0.0
# WEB_BIND=127.0.0.1
