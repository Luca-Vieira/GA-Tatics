# Servidor web interno do jogo. Fala só HTTP: o HTTPS fica com o proxy que já existe na VPS.
{
	auto_https off
	servers {
		# O proxy da VPS chega por um endereço da rede interna: o IP real de quem joga é o que ele informou.
		# "strict" lê o X-Forwarded-For da direita para a esquerda, então endereços inventados pelo visitante não valem.
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	# O que é do servidor de partidas: WebSocket do jogo, API do painel, sprites e verificação de saúde.
	@servidor path /ws /ws/* /api/* /sprites/* /health
	handle @servidor {
		reverse_proxy servidor:8787 {
			# O servidor recebe um único endereço: o de quem está do outro lado (usado no limite de login do painel).
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Todo o resto são os arquivos estáticos da página.
	handle {
		root * /srv
		redir /admin /admin/ 308
		# Os arquivos de /assets têm o hash no nome: o navegador pode guardá-los para sempre.
		@arquivos path /assets/*
		header @arquivos Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}/index.html
		file_server
	}
}
