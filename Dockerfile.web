# Página do jogo e painel de administração: constrói os arquivos estáticos e os serve com o Caddy,
# que também cuida do HTTPS e encaminha ao servidor de partidas o que é dele.
FROM node:22-alpine AS pagina
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY tsconfig.json vite.config.ts index.html ./
COPY admin ./admin
COPY src ./src
RUN npx vite build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=pagina /app/dist /srv
